# Hindsight env for one user (docs/m0/hindsight.md). install.sh renders this
# file to /etc/aios/hindsight/<uid>.env (owner <uid>, mode 0600) and replaces
# the @...@ placeholders. Never commit a rendered copy: it holds keys.
# Variable names checked against hindsight_api/config.py of hindsight-api-slim 1.0.0.
HINDSIGHT_API_HOST=127.0.0.1
HINDSIGHT_API_PORT=@HINDSIGHT_PORT@
HINDSIGHT_API_DATABASE_URL=postgresql://@DB_ROLE@@/@DB_NAME@?host=/run/postgresql

# LLM via Model Gateway, service key of client `hindsight` (cloud: false).
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_BASE_URL=http://127.0.0.1:@GATEWAY_PORT@/v1
HINDSIGHT_API_LLM_API_KEY=@GATEWAY_KEY@
HINDSIGHT_API_LLM_MODEL=s1
# The gateway runs one request per uid per local model; default is 32.
HINDSIGHT_API_LLM_MAX_CONCURRENT=1
HINDSIGHT_API_LLM_TIMEOUT=300

# Embeddings via Model Gateway (always local, REQ-D-5.2-04).
HINDSIGHT_API_EMBEDDINGS_PROVIDER=openai
HINDSIGHT_API_EMBEDDINGS_OPENAI_BASE_URL=http://127.0.0.1:@GATEWAY_PORT@/v1
HINDSIGHT_API_EMBEDDINGS_OPENAI_API_KEY=@GATEWAY_KEY@
HINDSIGHT_API_EMBEDDINGS_OPENAI_MODEL=embed-local

# Reranker: `rrf` = no cross-encoder (default `local` needs torch).
HINDSIGHT_API_RERANKER_PROVIDER=rrf

# Vietnamese text: no English stemming in the keyword (BM25) arm.
HINDSIGHT_API_TEXT_SEARCH_EXTENSION_NATIVE_LANGUAGE=simple
# Qwen3-4B wrote extracted facts in English for Vietnamese input both with
# and without this setting (docs/spikes/S-4-hindsight.md); kept for M1 tests.
HINDSIGHT_API_LLM_OUTPUT_LANGUAGE=Vietnamese

# API key on the Hindsight HTTP API: other local users must not read this
# user's banks through 127.0.0.1:8888.
HINDSIGHT_API_TENANT_EXTENSION=hindsight_api.extensions.builtin.tenant:ApiKeyTenantExtension
HINDSIGHT_API_TENANT_API_KEY=@API_KEY@

# No telemetry, no network lookups at import time.
HINDSIGHT_API_OTEL_TRACES_ENABLED=false
LITELLM_LOCAL_MODEL_COST_MAP=True
HF_HUB_OFFLINE=1
DO_NOT_TRACK=1
